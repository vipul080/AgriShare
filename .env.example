# Copy to .env on the server and fill in. .env is git-ignored — never commit it.

# Your free DuckDNS name (or own domain), without https://
DOMAIN=agrishare.duckdns.org

# Long random values. Generate each with:  openssl rand -base64 36
DB_PASSWORD=change-me
APP_JWT_SECRET=change-me-to-at-least-32-random-characters

# off = cash only (safe default for real farmers)
# mock = PRETEND payments - demos only, never where real farmers use the app
# razorpay = real payments (also set the two keys; test keys first)
PAYMENTS_MODE=off
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# true only on a demo server: adds 6 sample farmers (password demo1234) to an empty database
APP_DEMO_DATA=false

# Memory for Java. 24 GB ARM server: -Xmx1g is plenty. 1 GB AMD micro server: -Xmx300m
JAVA_OPTS=-Xmx512m -XX:+ExitOnOutOfMemoryError
